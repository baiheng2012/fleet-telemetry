{
  "uid": "fleet-overview",
  "title": "Fleet Telemetry Overview",
  "schemaVersion": 39,
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "refresh": "1m",
  "editable": true,
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Alerts: fail",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) as fail from dq.active_alerts where severity = 'fail'"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Alerts: warn",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) as warn from dq.active_alerts where severity = 'warn'"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Vehicles reporting (<10 min)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) as vehicles from dq.latest_results where check_name = 'freshness_seconds' and value < 600"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Active alerts",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select source, severity, alert, at from dq.active_alerts order by (severity = 'fail') desc, at desc"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Daily utilization (engine hours / 24h)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select day::timestamp as time, vehicle_id as metric, utilization_ratio as value from semantic.fct_vehicle_daily where $__timeFilter(day::timestamp) order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Engine hours per hour (hour meter)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select hour_start_utc as time, vehicle_id as metric, engine_hours as value from semantic.fct_vehicle_hourly where $__timeFilter(hour_start_utc) order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Coolant temperature, running only (5 min mean)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select bucket as time, vehicle_id as metric, coolant_mean as value from semantic.ml_features where running and $__timeFilter(bucket) order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "OEM KPIs per vehicle",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select vehicle_id, round(avg(utilization_ratio)::numeric, 3) as avg_utilization, round(sum(engine_hours)::numeric, 1) as engine_hours, round((100.0 * sum(fault_samples) / nullif(sum(samples), 0))::numeric, 3) as fault_pct from semantic.fct_vehicle_daily where $__timeFilter(day::timestamp) group by 1 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Fault samples per vehicle",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select vehicle_id, sum(fault_samples)::int as fault_samples from semantic.fct_vehicle_daily where $__timeFilter(day::timestamp) group by 1 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Freshness SLA (seconds since last message)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select scope as vehicle, round(value::numeric, 1) as seconds, status from dq.latest_results where check_name = 'freshness_seconds' order by scope"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Data-quality rates (latest)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select check_name, scope, round(value::numeric, 5) as value, status from dq.latest_results where check_name not in ('freshness_seconds') order by (status = 'pass'), check_name, scope"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Anomalies (robust z-score)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select bucket, vehicle_id, signal, round(value::numeric, 1) as value, round(baseline::numeric, 1) as baseline, round(z::numeric, 1) as z from semantic.anomalies order by bucket desc limit 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
